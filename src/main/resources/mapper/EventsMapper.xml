<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ticket.events.mapper.EventsMapper">
    <select id="getLists" resultType="com.ticket.events.entity.Events">
        select * from ticket.t_event
        where status = 1
    </select>


</mapper>