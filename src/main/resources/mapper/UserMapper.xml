<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ticket.user.mapper.UserMapper">

    <!-- ======================================================
         ResultMap：列名 → 字段名 驼峰映射
         （也可在 application.yml 开启 map-underscore-to-camel-case: true 代替）
    ====================================================== -->
    <resultMap id="UserResultMap" type="com.ticket.user.entity.UserEntity">
        <id     column="id"            property="id"/>
        <result column="username"      property="username"/>
        <result column="password" property="password"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="phone"         property="phone"/>
        <result column="real_name"     property="realName"/>
        <result column="status"        property="status"/>
        <result column="created_at"    property="createdAt"/>
        <result column="updated_at"    property="updatedAt"/>
    </resultMap>


    <!-- ======================================================
         INSERT：新增用户
         useGeneratedKeys=true → MyBatis 把自增 id 回填到 entity.id
         注册成功后 entity.getId() 即可拿到真实主键
    ====================================================== -->
    <insert id="insert"
            parameterType="com.ticket.user.entity.UserEntity"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO t_user (
            username,
            password_hash,
            phone,
            real_name,
            status
        ) VALUES (
                     #{username},
                     #{passwordHash},
                     #{phone},
                     #{realName},
                     #{status}
                 )
    </insert>


    <!-- ======================================================
         SELECT：按用户名查用户（登录 / 注册查重共用）
         返回完整 UserEntity（含 passwordHash / passwordSalt）
    ====================================================== -->
    <select id="findByUsername"
            parameterType="java.lang.String"
            resultMap="UserResultMap">
        SELECT id, username, password_hash,
               phone, real_name, status, created_at, updated_at
        FROM t_user
        WHERE username = #{username}
        LIMIT 1
    </select>


    <!-- ======================================================
         SELECT：注册查重专用（只判断是否存在，不取全量字段）
         返回 Boolean：存在→true，不存在→false（MyBatis 映射 0/1 到 Boolean）
         用法：if (userMapper.existsByUsername(username)) { throw ... }
    ====================================================== -->
    <select id="existsByUsername"
            parameterType="java.lang.String"
            resultType="java.lang.Boolean">
        SELECT COUNT(1) > 0
        FROM t_user
        WHERE username = #{username}
    </select>
    <select id="getuserNameById" resultType="java.lang.String">
        select username from t_user where id = #{userId}
    </select>

</mapper>